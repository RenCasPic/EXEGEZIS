{
  "plan": {
    "title": "Wishlist button adds the product",
    "description": "Click Add to wishlist and check the wishlist counter.",
    "preconditions": [],
    "steps": [
      {
        "type": "navigate",
        "value": "/"
      },
      {
        "type": "assert",
        "id": "counter-initial",
        "purpose": "anchor",
        "description": "The cart counter starts at Cart (0)",
        "assertion": {
          "kind": "text",
          "target": {
            "by": "role",
            "value": "link",
            "name": "Cart"
          },
          "operator": "equals",
          "expected": "Cart (0)"
        }
      },
      {
        "type": "click",
        "target": {
          "by": "role",
          "value": "button",
          "name": "Add Wireless Mouse to wishlist"
        }
      },
      {
        "type": "assert",
        "id": "wishlist-updated",
        "purpose": "expectation",
        "description": "The wishlist shows one item",
        "assertion": {
          "kind": "text",
          "target": {
            "by": "role",
            "value": "link",
            "name": "Wishlist"
          },
          "operator": "equals",
          "expected": "Wishlist (1)"
        }
      }
    ]
  }
}
