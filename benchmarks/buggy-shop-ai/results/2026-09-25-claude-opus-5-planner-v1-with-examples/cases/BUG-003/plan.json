      "assertion": {
        "kind": "text",
        "target": {
          "role": "link",
          "name": "Cart"
        },
        "operator": "equals",
        "expected": "Cart (0)"
      }
    },
    {
      "type": "click",
      "target": {
        "role": "button",
        "name": "Add Mechanical Keyboard to cart"
      }
    },
    {
      "type": "assert",
      "id": "keyboard-in-cart",
      "description": "The cart holds one keyboard before checkout",
      "purpose": "anchor",
      "assertion": {
        "kind": "visibility",
        "target": {
          "text": "Mechanical Keyboard × 1"
        },
        "expected": "visible"
      }
    },
    {
      "type": "click",
      "target": {
        "role": "button",
        "name": "Checkout"
      }
    },
    {
      "type": "assert",
      "id": "badge-after-checkout",
      "description": "The cart badge is back to Cart (0) after checkout",
      "purpose": "anchor",
      "assertion": {
        "kind": "text",
        "target": {
          "role": "link",
          "name": "Cart"
        },
        "operator": "equals",
