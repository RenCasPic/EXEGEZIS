      "purpose": "anchor",
      "assertion": {
        "kind": "visibility",
        "target": {
          "text": "Wireless Mouse × 1"
        },
        "expected": "visible"
      }
    },
    {
      "type": "assert",
      "id": "badge-after-new-add",
      "description": "After checkout, adding one mouse leaves exactly one item in the cart, so the badge shows Cart (1)",
      "purpose": "expectation",
      "assertion": {
        "kind": "text",
        "target": {
          "role": "link",
          "name": "Cart"
        },
        "operator": "equals",
        "expected": "Cart (1)"
