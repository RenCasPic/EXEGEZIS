# Cloud mode (accounts, sign-in, each user's data apart): docs/13-accounts.md.
#   copy .env.cloud.example .env.cloud
#   notepad .env.cloud
# Only `pnpm web:cloud` and `pnpm exegezis:cloud` read this file; the tests never
# do. It is ignored by git. Variables set in the terminal win over it, and it
# wins over .env (which still provides the shared ones, like the AI key).

# Supabase project (Dashboard → Project Settings → API). With a local
# `npx supabase start`, the command prints both (also: npx supabase status).
SUPABASE_URL=http://127.0.0.1:54321
# The public «anon» key (the app uses it on the server only).
SUPABASE_ANON_KEY=

# SECRET. Postgres connection (Dashboard → Connect → Session pooler). The app
# connects as the owner and switches to each user's role for everything it does
# on their behalf, so Row Level Security applies.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Where the app is published, without a trailing slash: email links and OAuth
# come back here. The landing, sign-in and the app share it (one domain).
EXEGEZIS_APP_URL=http://127.0.0.1:4100

# OAuth providers configured in Supabase (Authentication → Providers), comma
# separated: google,github. Empty: those buttons do not appear.
EXEGEZIS_OAUTH_PROVIDERS=

# Folder for each user's heavy artifacts (screenshots, traces, DOM), one
# sub-folder per user: <dir>/users/<id>/. Default: data/ in the repository.
EXEGEZIS_DATA_DIR=

# SECRET. 32 random bytes in base64 that encrypt each user's saved site
# accesses on a server without a desktop keyring. Create it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it outside the data folder: losing it makes the saved accesses unreadable.
EXEGEZIS_ACCESS_KEY=

# How many proxies in front of the app append to X-Forwarded-For (for the
# rate limits). Behind one load balancer: 1.
EXEGEZIS_PROXY_HOPS=1

# Postgres connections per app process.
EXEGEZIS_DB_MAX_CONNECTIONS=5

# Tests only (never in production): run the cloud end-to-end tests against a
# real `npx supabase start` instead of the built-in stand-in. Set these in the
# terminal, not here (the tests never read this file):
#   EXEGEZIS_TEST_SUPABASE=1, SUPABASE_URL, SUPABASE_ANON_KEY, DATABASE_URL, MAILPIT_URL
