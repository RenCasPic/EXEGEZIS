{
  "name": "@exegezis/web",
  "version": "0.1.0",
  "private": true,
  "description": "EXEGEZIS local web UI. Reads real run artifacts; never invents results.",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4100",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@exegezis/core": "workspace:*",
    "@exegezis/planner": "workspace:*",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5",
    "@exegezis/access": "workspace:*"
  },
  "devDependencies": {
    "@exegezis/inspect": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
