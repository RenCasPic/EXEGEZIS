{
  "name": "@exegezis/cli",
  "version": "0.1.0",
  "private": true,
  "description": "EXEGEZIS command line interface.",
  "type": "module",
  "bin": {
    "exegezis": "./bin/exegezis.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "dependencies": {
    "@exegezis/access": "workspace:*",
    "@exegezis/accounts": "workspace:*",
    "@exegezis/adapter-browser": "workspace:*",
    "@exegezis/compiler-playwright": "workspace:*",
    "@exegezis/core": "workspace:*",
    "@exegezis/inspect": "workspace:*",
    "@exegezis/planner": "workspace:*",
    "@exegezis/search": "workspace:*",
    "intl-messageformat": "11.2.15",
    "zod": "^4.6.5"
  }
}
