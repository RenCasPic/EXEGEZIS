{
  "name": "@exegezis/compiler-playwright",
  "version": "0.1.0",
  "private": true,
  "description": "Compiles EXEGEZIS test plans into standalone Playwright specs, and runs them with the standard Playwright runner.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@exegezis/core": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0"
  }
}
