{
  "name": "@exegezis/inspect",
  "version": "0.1.0",
  "private": true,
  "description": "EXEGEZIS web inspection: open a URL without a symptom, walk it read-only and report deterministic, evidence-backed findings.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@exegezis/adapter-browser": "workspace:*",
    "@exegezis/compiler-playwright": "workspace:*",
    "@exegezis/core": "workspace:*",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "selfsigned": "5.5.0",
    "@exegezis/access": "workspace:*"
  }
}
