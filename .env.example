# Copy this file to .env (in this folder) and fill in the values. .env is ignored by git:
# no secret ever goes into the repository. The CLI, the app (apps/web) and the
# landing (apps/site) all read this one file. Variables already set in the
# environment win over it.

# ---------------------------------------------------------------------------
# AI (optional, both modes)
# ---------------------------------------------------------------------------
# Anthropic API key for the AI planner and search by meaning (generate-plan,
# ai-verify, benchmark --planner anthropic, search --meaning).
EXEGEZIS_ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Mode (docs/13-accounts.md)
# ---------------------------------------------------------------------------
# local (default): one person, no sign-in, only on 127.0.0.1, data in runs/.
# cloud: accounts (Supabase Auth), sign-in required, each user's data apart.
EXEGEZIS_MODE=local

# ---------------------------------------------------------------------------
# Cloud mode only (EXEGEZIS_MODE=cloud). Everything below is ignored in local mode.
# ---------------------------------------------------------------------------
# Supabase project (Dashboard → Project Settings → API). With a local
# `supabase start`, the command prints both.
SUPABASE_URL=
# The public «anon» key (safe in the browser; the app uses it on the server only).
SUPABASE_ANON_KEY=
# Postgres connection (Dashboard → Connect → Session pooler, or the direct one).
# SECRET: it connects as the database owner. The app switches to each user's
# role for everything it does on their behalf, so Row Level Security applies.
# Example (local): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
# Where the app is published, without a trailing slash. Email links and OAuth
# come back here. Local: http://127.0.0.1:4100 · Production: https://app.exegezis.com
EXEGEZIS_APP_URL=http://127.0.0.1:4100
# Where the landing is published («See plans», help, legal pages, and the only
# origin allowed to ask /api/session). Local: http://127.0.0.1:4200
EXEGEZIS_SITE_URL=http://127.0.0.1:4200
# OAuth providers configured in Supabase (Authentication → Providers), comma
# separated: google,github. Empty: those buttons do not appear.
EXEGEZIS_OAUTH_PROVIDERS=
# Share the session between the landing and the app on subdomains (e.g.
# .exegezis.com). Empty: the app's own host only (recommended unless needed).
EXEGEZIS_COOKIE_DOMAIN=
# Folder for each user's heavy artifacts (screenshots, traces, DOM), one
# sub-folder per user: <dir>/users/<id>/. Default: data/ in this folder.
EXEGEZIS_DATA_DIR=
# SECRET: 32 random bytes in base64 that encrypt each user's saved site
# accesses on a server without a desktop keyring. Create it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it outside the data folder; losing it makes the saved accesses unreadable.
EXEGEZIS_ACCESS_KEY=
# How many proxies in front of the app append to X-Forwarded-For (for the
# rate limits). Behind one load balancer: 1.
EXEGEZIS_PROXY_HOPS=1
# Postgres connections per app process.
EXEGEZIS_DB_MAX_CONNECTIONS=5

# ---------------------------------------------------------------------------
# Landing (apps/site): read when it is built (`pnpm build:site`) or served (`pnpm site`)
# ---------------------------------------------------------------------------
# local (default): the buttons open the app on this computer. cloud: /login and /signup.
NEXT_PUBLIC_EXEGEZIS_MODE=local
# The app the buttons open.
NEXT_PUBLIC_EXEGEZIS_APP_URL=http://127.0.0.1:4100
# The landing's public address (Open Graph).
NEXT_PUBLIC_EXEGEZIS_SITE_URL=http://127.0.0.1:4200
# Contact for privacy matters, shown in the privacy policy. TODO: the real address.
NEXT_PUBLIC_EXEGEZIS_PRIVACY_EMAIL=
# Contact for «Talk to sales» (a mailto: or a form). TODO: the real address.
NEXT_PUBLIC_EXEGEZIS_SALES_URL=

# ---------------------------------------------------------------------------
# Tests only (never in production)
# ---------------------------------------------------------------------------
# Run the cloud end-to-end tests against a real `supabase start` instead of
# the built-in stand-in (docs/13-accounts.md): EXEGEZIS_TEST_SUPABASE=1 plus
# SUPABASE_URL, SUPABASE_ANON_KEY, DATABASE_URL and MAILPIT_URL.
# EXEGEZIS_TEST_SUPABASE=
# MAILPIT_URL=http://127.0.0.1:54324
