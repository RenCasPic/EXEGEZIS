# Local mode (the default): copy this file to .env and fill in what you use.
#   copy .env.example .env
# .env is ignored by git: no secret ever goes into the repository. The CLI and
# the app (`pnpm web`, http://127.0.0.1:4100) read it. `pnpm web`, `pnpm verify`
# and the tests always run in local mode, whatever this file says.
# Cloud mode has its own file: .env.cloud (see .env.cloud.example).

# Anthropic API key for the AI planner and search by meaning (generate-plan,
# ai-verify, benchmark --planner anthropic, search --meaning). Optional.
EXEGEZIS_ANTHROPIC_API_KEY=

# Contacts shown on the public pages (/producto, /privacidad…). TODO: the real ones;
# until then they use reserved .example addresses that reach nobody.
EXEGEZIS_PRIVACY_EMAIL=
EXEGEZIS_SALES_URL=
