# Copy this file to .env and fill it in:
#   copy .env.example .env
#   notepad .env
# .env is ignored by git: no secret ever goes into the repository. The app
# (`pnpm web`, http://127.0.0.1:4100) and the CLI read it. Variables set in the
# terminal win over it. The tests never read it (they bring their own
# stand-in of Supabase).

# --- Supabase (required by the app): docs/13-accounts.md ---
# Your project on supabase.com → Project Settings → API Keys. No Docker and no
# database password: these three are enough.
# The project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The public «anon» key (or the «publishable» key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. The «service_role» key (or a «secret» key). Server only, never shown
# in the browser: rate limits, deleting an account, the CLI's claim-local.
SUPABASE_SERVICE_ROLE_KEY=

# Where the app is published, without a trailing slash: email links come back
# here. Default: http://127.0.0.1:4100 (pnpm web).
EXEGEZIS_APP_URL=

# --- Optional ---

# OAuth providers configured in Supabase (Authentication → Providers), comma
# separated: google,github. Empty: those buttons do not appear.
EXEGEZIS_OAUTH_PROVIDERS=

# Folder for each user's heavy artifacts (screenshots, traces, DOM), one
# sub-folder per user: <dir>/users/<id>/. Default: data/ in the repository.
EXEGEZIS_DATA_DIR=

# SECRET. On a server without a desktop keyring: 32 random bytes in base64 that
# encrypt each user's saved site accesses. Create it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it outside the data folder: losing it makes the saved accesses unreadable.
EXEGEZIS_ACCESS_KEY=

# How many proxies in front of the app append to X-Forwarded-For (for the
# rate limits). Behind one load balancer: 1.
EXEGEZIS_PROXY_HOPS=1

# Anthropic API key for the AI planner and search by meaning (investigations,
# generate-plan, ai-verify, search --meaning).
EXEGEZIS_ANTHROPIC_API_KEY=

# Contacts shown on the public pages (/producto, /privacidad…). TODO: the real ones;
# until then they use reserved .example addresses that reach nobody.
EXEGEZIS_PRIVACY_EMAIL=
EXEGEZIS_SALES_URL=
