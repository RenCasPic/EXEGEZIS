{
  "name": "exegezis",
  "private": true,
  "description": "EXEGEZIS — Software that explains itself.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && pnpm --filter buggy-shop typecheck && pnpm --filter inspect-lab typecheck && pnpm --filter @exegezis/web typecheck",
    "lint": "eslint .",
    "test": "tsc -b && vitest run && pnpm --filter buggy-shop test && pnpm --filter buggy-shop test:known-bugs",
    "test:exegezis": "tsc -b && vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "exegezis": "exegezis",
    "clean": "tsc -b --clean",
    "benchmark": "exegezis benchmark --suite buggy-shop",
    "web": "pnpm build && pnpm --filter @exegezis/web dev",
    "build:web": "pnpm build && pnpm --filter @exegezis/web build",
    "dev": "pnpm web"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@exegezis/cli": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "axe-core": "4.13.0"
    }
  }
}
